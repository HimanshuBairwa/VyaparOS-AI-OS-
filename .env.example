# ========================================================
# VyaparOS AI (व्यापारOS) — Environment Configuration
# Paytm Merchant Growth AI Track Hackathon Prototype
# ========================================================

# Database (SQLite instance; on Vercel automatically maps to /tmp/dev.db)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# AI Copilot & Vision Engine (Claude Sonnet 4.6 via VyceAI)
AI_BASE_URL="https://vyceai.com/v1"
AI_API_KEY="your-vyceai-api-key-here"
AI_MODEL="claude-sonnet-4-6"

# Paytm Merchant Growth & Soundbox Credentials (Optional for live production sandbox)
# When omitted, VyaparOS runs in high-fidelity simulated Paytm provider mode with full Soundbox audio
PAYTM_MERCHANT_ID="MUNAFA_RETAIL_01"
PAYTM_MERCHANT_KEY="DEMO_MERCHANT_KEY"
PAYTM_ENVIRONMENT="TEST"
